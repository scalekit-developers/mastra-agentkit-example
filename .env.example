# Scalekit — from app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=your_client_secret_here

# OpenAI
OPENAI_API_KEY=sk-...

# User identifier — replace with the real user ID from your application
USER_IDENTIFIER=user_123

# Connection name — must match the connection configured in your Scalekit dashboard
CONNECTION_NAME=gmail
